# Celoura Fashion Production Environment Configuration
# Copy this file to .env on your production server: cp .env.production.example .env

# Your server's public domain or IP address (e.g., http://123.45.67.89:8080/api or https://api.celoura.com/api)
NEXT_PUBLIC_API_URL=http://YOUR_SERVER_IP:8080/api

# PostgreSQL Database Credentials
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ChangeThisToAStrongSecretPassword123!
